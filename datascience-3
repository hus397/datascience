import pandas as pd
data = pd.read_csv('titanic.csv')

print(data[data['Age']>=18]['Name'])
#getting a particular column out of a condition
print(data.loc[data['Age']>=18, 'Name']) #loc --> locate, not a function
print(data.iloc[1::2, 1::3]) #rows, columns
print(data['Age'])
data['Age'] += 5
print(data['Age'])
data['Sex'] = data['Sex'].replace({'male':'M', 'female':'F'}) #modify/replace columns
print(data['Sex'])
data['Survived'] = data['Survived'].replace({0:'Died', 1:'Survived'})
print(data['Survived'])
#add data

#calculate discount, 10% of fare and store in dataset
data['Discount'] = data['Fare']*0.1
print(data)
print(data.drop('Fare', axis=1))

#inplace - parameter whether changes are made in the original dataset

#renaming columns
data_renamed = data.rename(
    columns={
        "Pclass":"Passenger Class",
        "Survived":"Alive",
        "Parents/Children Aboard":"Parents + Kids Aboard"
    }
)
print(data_renamed)

#mean of ages
print(data[['Fare', 'Age']].mean())

#sorting data
data.sort_values(by="Age", inplace = True, ascending=False)
print(data[['Name', 'Age']])

#operations on text data
data["Name_lowercase"] = data['Name'].str.lower()
print(data[['Name_lowercase', 'Age']])

#split name
data["surname"] = data["Name"].str.split(" ").str.get(-1)
print(data[['surname', 'Age']])

#count of people in each passenger class: value counts gives the count of each value
print(data['Pclass'].value_counts())
print(data.groupby('Pclass')['Name'].count())

#for each male and female of each passenger class, show the minimum and maximum fare
print(data.groupby(['Sex', 'Pclass'])['Fare'].agg([min, max]))
